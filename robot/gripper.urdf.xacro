<?xml version="1.0"?>
<!-- Things the arm's tool0: the wrist camera bracket, the camera on it and the gripper under
     it, posed as in urdf/ur12e.urdf. robotiq_description's own 2F-140 file fixes the gripper to
     `world` instead. -->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="robotiq_gripper">
  <xacro:arg name="use_fake_hardware" default="true"/>
  <xacro:arg name="com_port" default="/tmp/ttyUR"/>

  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_2f_140_macro.urdf.xacro"/>

  <!-- RViz only loads meshes from package:// or file:// URIs, and this xacro has no $(dirname).
       abs_filename works from the path xacro was given, which launch.xml makes absolute. -->
  <xacro:property name="assets" value="file://${xacro.abs_filename('assets')}" lazy_eval="false"/>

  <!-- The bracket and camera CAD share an origin 6.4 mm behind the face that seats on the flange,
       and turning it 7/8 pi puts the bracket's dowel hole on the flange's, on tool0's -Y. -->
  <xacro:macro name="cad_part" params="mesh material:=''">
    <visual>
      <origin xyz="0 0 -0.0064" rpy="0 0 ${7 * pi / 8}"/>
      <geometry>
        <mesh filename="${assets}/${mesh}"/>
      </geometry>
      <xacro:if value="${material != ''}">
        <material name="${material}"/>
      </xacro:if>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0064" rpy="0 0 ${7 * pi / 8}"/>
      <geometry>
        <mesh filename="${assets}/${mesh}"/>
      </geometry>
    </collision>
  </xacro:macro>

  <material name="purple">
    <color rgba="0.5 0.2 0.75 1"/>
  </material>

  <link name="tool0"/>

  <link name="wrist_bracket">
    <xacro:cad_part mesh="wrist_bracket_arm.stl" material="purple"/>
    <xacro:cad_part mesh="wrist_bracket_camera_plate.stl" material="purple"/>
    <xacro:cad_part mesh="orbbec_gemini_336.stl"/>
    <!-- The PLA bracket, 250 g from its 201 cm3, and Orbbec's 99 g camera spread evenly through its
         90 x 30 x 25 mm housing. For another plastic, scale the bracket's share by its density. -->
    <inertial>
      <mass value="0.349"/>
      <origin xyz="-0.026 -0.0626 0.0214" rpy="0 0 0"/>
      <inertia ixx="1.682e-03" ixy="-5.590e-04" ixz="1.428e-04" iyy="5.621e-04" iyz="3.453e-04" izz="1.930e-03"/>
    </inertial>
  </link>
  <joint name="tool0-wrist_bracket" type="fixed">
    <parent link="tool0"/>
    <child link="wrist_bracket"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- The bracket's outer face repeats the flange's ISO 9409-1-50-4-M6 pattern, turned 22.5
       degrees from it. Like tool0, this frame has the dowel hole on -Y. Robotiq's macro pins its
       robotiq_base_link to the parent it is given, so this frame is what puts that on the face. -->
  <link name="gripper_mount"/>
  <joint name="wrist_bracket-gripper_mount" type="fixed">
    <parent link="wrist_bracket"/>
    <child link="gripper_mount"/>
    <origin xyz="0 0 0.0244" rpy="0 0 ${-pi / 8}"/>
  </joint>

  <xacro:robotiq_gripper name="RobotiqGripperHardwareInterface" prefix="" parent="gripper_mount"
                         use_fake_hardware="$(arg use_fake_hardware)" com_port="$(arg com_port)">
    <!-- Straight onto the bracket, whose centring bore takes the gripper's spigot. A coupling in
         between would add its thickness to z. -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:robotiq_gripper>
</robot>
